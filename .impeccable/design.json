  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Copper action, used to start an analysis.",
      "html": "<button class=\"ds-btn-primary\">Analyze 3 days</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:36px;padding:6px 14px;border-radius:4px;background:var(--copper);border:1px solid var(--copper);color:#fff;font-size:13px;font-weight:600;white-space:nowrap;cursor:pointer;transition:background-color 150ms ease-out,border-color 150ms ease-out}:root[data-theme=dark] .ds-btn-primary{color:#1a120e}.ds-btn-primary:hover:not(:disabled){background:var(--copper-hover);border-color:var(--copper-hover)}.ds-btn-primary:focus-visible{outline:3px solid var(--focus);outline-offset:2px;border-radius:2px}.ds-btn-primary:active:not(:disabled){filter:brightness(.95)}.ds-btn-primary:disabled{opacity:.55;cursor:not-allowed}"
    },
    {
      "name": "Default Button",
      "kind": "button",
      "refersTo": "button",
      "description": "Secondary actions such as Stop and Download.",
      "html": "<button class=\"ds-btn\">Download GeoJSON</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:7px;min-height:36px;padding:6px 14px;border-radius:4px;background:var(--paper);border:1px solid var(--rule-strong);color:var(--ink);font-size:13px;font-weight:600;white-space:nowrap;cursor:pointer;transition:background-color 150ms ease-out,border-color 150ms ease-out}.ds-btn:hover:not(:disabled){background:var(--surface);border-color:var(--faint)}.ds-btn:focus-visible{outline:3px solid var(--focus);outline-offset:2px;border-radius:2px}.ds-btn:active:not(:disabled){filter:brightness(.95)}.ds-btn:disabled{opacity:.55;cursor:not-allowed}"
    },
    {
      "name": "Field",
      "kind": "input",
      "refersTo": "field",
      "description": "Native select or input with a paper fill.",
      "html": "<select class=\"ds-input\" aria-label=\"Route\"><option>All routes</option></select>",
      "css": ".ds-input{height:36px;padding:0 10px;border-radius:4px;background:var(--paper);border:1px solid var(--rule-strong);font-size:13px;font-weight:450;color:var(--ink)}.ds-input:hover{border-color:var(--faint)}.ds-input:focus-visible{outline:3px solid var(--focus);outline-offset:2px;border-radius:2px}"
    },
    {
      "name": "Segmented Control",
      "kind": "chip",
      "refersTo": "segment",
      "description": "One choice from a small set, carried by aria-pressed.",
      "html": "<div class=\"ds-seg\" role=\"group\" aria-label=\"Measure\"><button aria-pressed=\"true\">Speed</button><button aria-pressed=\"false\">Against midday</button></div>",
      "css": ".ds-seg{display:inline-flex;flex-wrap:wrap;max-width:100%;padding:2px;gap:2px;border:1px solid var(--rule-strong);border-radius:5px;background:var(--paper)}.ds-seg button{min-height:28px;padding:2px 10px;border:0;border-radius:3px;background:none;color:var(--muted);font-size:12.5px;font-weight:550;white-space:nowrap;cursor:pointer;transition:background-color 120ms ease-out,color 120ms ease-out}.ds-seg button:hover:not([aria-pressed=\"true\"]){background:var(--surface);color:var(--ink)}.ds-seg button[aria-pressed=\"true\"]{background:var(--ink);color:var(--paper)}.ds-seg button:focus-visible{outline:3px solid var(--focus);outline-offset:2px;border-radius:2px}"
    },
    {
      "name": "Report Rail",
      "kind": "nav",
      "refersTo": "nav-item",
      "description": "Report navigation. Active is a surface fill with a copper icon.",
      "html": "<nav class=\"ds-rail\" aria-label=\"Reports\"><button class=\"active\" aria-current=\"page\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 20 20\" aria-hidden=\"true\"><path d=\"M3 16.5V10m4.7 6.5V4m4.6 12.5V8m4.7 8.5v-5\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Overview</button><button><svg width=\"18\" height=\"18\" viewBox=\"0 0 20 20\" aria-hidden=\"true\"><path d=\"M10 18a8 8 0 100-16 8 8 0 000 16zM10 5.5V10l3 2\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg>Reliability</button></nav>",
      "css": ".ds-rail{display:grid;gap:1px;width:180px}.ds-rail button{display:flex;align-items:center;gap:10px;min-height:36px;padding:4px 8px;border:0;border-radius:4px;background:none;color:var(--muted);font-size:13.5px;font-weight:500;text-align:left;cursor:pointer;transition:background-color 120ms ease-out,color 120ms ease-out}.ds-rail button:hover{background:var(--surface);color:var(--ink)}.ds-rail button.active{background:var(--surface);color:var(--ink);font-weight:650}.ds-rail button.active svg{color:var(--copper)}.ds-rail button:focus-visible{outline:3px solid var(--focus);outline-offset:2px;border-radius:2px}"
    },
    {
      "name": "Ruled Figure Strip",
      "kind": "custom",
      "refersTo": "figure",
      "description": "Key figures between two rules, each name linking to its method.",
      "html": "<dl class=\"ds-stats\"><div><dt><button class=\"ds-term\" title=\"How this is calculated\">Operating speed</button></dt><dd>15.3 <small>mph</small></dd><span>15.1 scheduled, stops included</span></div><div><dt><button class=\"ds-term\" title=\"How this is calculated\">On-time departures</button></dt><dd>73%</dd><span>15% late, at timepoints</span></div></dl>",
      "css": ".ds-stats{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));margin:0;border-block:1px solid var(--rule)}.ds-stats>div{padding:12px 16px 13px 0;display:grid;gap:1px;align-content:start;min-width:0}.ds-stats>div+div{padding-left:16px;border-left:1px solid var(--rule)}.ds-stats dt{font-size:12px;font-weight:600;color:var(--muted)}.ds-stats dd{margin:0;font-size:27px;font-weight:650;line-height:1.2;letter-spacing:-.02em;color:var(--ink)}.ds-stats small{font-size:13px;font-weight:500;color:var(--muted);letter-spacing:0}.ds-stats span{font-size:12px;color:var(--muted);line-height:1.35}.ds-term{all:unset;cursor:pointer;text-decoration:underline dotted var(--rule-strong) 1px;text-underline-offset:3px;transition:color 120ms ease-out}.ds-term:hover{color:var(--copper);text-decoration-color:currentColor}.ds-term:focus-visible{outline:2px solid var(--focus);outline-offset:2px;border-radius:2px}"
    },
    {
      "name": "Data Table",
      "kind": "custom",
      "refersTo": "table-cell",
      "description": "Sticky first column and header, right-edge scroll shadow, and a Show all link.",
      "html": "<div class=\"ds-wrap\" tabindex=\"0\" role=\"region\" aria-label=\"Routes\"><table class=\"ds-table\"><thead><tr><th class=\"left\">Route</th><th>Peak speed</th><th>Midday speed</th><th>On time</th><th>Excess wait</th><th>Vehicle hours</th><th>Trips a day</th></tr></thead><tbody><tr><td class=\"left\">Route 80</td><td>8.6</td><td>9.9</td><td>68%</td><td>1.2 min</td><td>142</td><td>210</td></tr><tr><td class=\"left\">Route L</td><td>10.4</td><td>12.0</td><td>74%</td><td>—</td><td>96</td><td>118</td></tr></tbody></table></div><button class=\"ds-more\">Show all 29</button>",
      "css": ".ds-wrap{overflow:auto;max-width:440px;border-block:1px solid var(--rule);background:linear-gradient(to left,var(--paper) 40%,transparent) right center/36px 100% no-repeat local,linear-gradient(to left,color-mix(in srgb,var(--ink) 14%,transparent),transparent) right center/14px 100% no-repeat scroll}.ds-table{border-collapse:separate;border-spacing:0;width:100%;font-size:13px;color:var(--ink)}.ds-table th,.ds-table td{padding:7px 10px;text-align:right;white-space:nowrap;border-bottom:1px solid var(--rule)}.ds-table td{font-variant-numeric:tabular-nums}.ds-table tr:last-child td{border-bottom:0}.ds-table th{position:sticky;top:0;z-index:2;background:var(--paper);font-size:11.5px;font-weight:600;color:var(--muted);box-shadow:inset 0 -1px 0 var(--rule-strong);border-bottom:0}.ds-table .left{text-align:left}.ds-table th:first-child,.ds-table td:first-child{position:sticky;left:0;background:var(--paper);box-shadow:inset -1px 0 0 var(--rule)}.ds-table th:first-child{z-index:3;box-shadow:inset 0 -1px 0 var(--rule-strong),inset -1px 0 0 var(--rule)}.ds-table tbody tr:hover td{background:var(--surface)}.ds-more{margin-top:8px;background:none;border:0;padding:0;color:var(--copper);font-size:13px;font-weight:600;text-decoration:underline;text-decoration-color:transparent;text-underline-offset:3px;cursor:pointer}.ds-more:hover{color:var(--copper-hover);text-decoration-color:currentColor}.ds-more:focus-visible,.ds-wrap:focus-visible{outline:3px solid var(--focus);outline-offset:2px;border-radius:2px}"
    },
    {
      "name": "Numbered Hotspot Marker",
      "kind": "custom",
      "refersTo": "rank-marker",
      "description": "Map marker whose number matches the ranked list beside the map.",
      "html": "<button class=\"ds-rank\" type=\"button\" aria-label=\"Stretch ranked 1\">1</button>",
      "css": ".ds-rank{width:20px;height:20px;padding:0;border:1.5px solid var(--paper);border-radius:50%;background:var(--ink);color:var(--paper);font-size:11px;font-weight:650;line-height:1;font-variant-numeric:tabular-nums;cursor:pointer}.ds-rank:hover{background:var(--copper)}.ds-rank:focus-visible{outline:2px solid var(--focus);outline-offset:2px}"
    },
    {
      "name": "Speed Legend",
      "kind": "custom",
      "refersTo": "c0",
      "description": "The seven speed classes, shown beside any map or heatmap that uses them.",
      "html": "<div class=\"ds-legend\" aria-label=\"Speed colors\"><strong>mph</strong><span><i style=\"background:var(--c0)\"></i>under 5</span><span><i style=\"background:var(--c1)\"></i>5–8</span><span><i style=\"background:var(--c2)\"></i>8–10</span><span><i style=\"background:var(--c3)\"></i>10–13</span><span><i style=\"background:var(--c4)\"></i>13–16</span><span><i style=\"background:var(--c5)\"></i>16–20</span><span><i style=\"background:var(--c6)\"></i>20+</span></div>",
      "css": ".ds-legend{display:flex;flex-wrap:wrap;gap:4px 14px;font-size:12px;color:var(--muted)}.ds-legend span{display:inline-flex;align-items:center;gap:6px}.ds-legend i{width:12px;height:12px;border-radius:2px;flex:none}"
    },
    {
      "name": "Tooltip",
      "kind": "custom",
      "refersTo": "tooltip",
      "description": "Inverted ink tooltip for exact values on charts and maps.",
      "html": "<div class=\"ds-tip\"><div class=\"t\">13.7 mph</div><div class=\"n\">4 PM–5 PM</div><div class=\"r\"><span>Measurements</span><span>412</span></div></div>",
      "css": ".ds-tip{display:inline-block;max-width:300px;padding:8px 10px;background:var(--ink);color:var(--paper);border-radius:5px;font-size:12.5px;line-height:1.4;box-shadow:var(--shadow-pop);font-variant-numeric:tabular-nums}.ds-tip .t{font-weight:650}.ds-tip .n{opacity:.78}.ds-tip .r{display:flex;justify-content:space-between;gap:16px}.ds-tip .r span:first-child{opacity:.78}"
    }
  ],
  "narrative": {
    "northStar": "The Transit Almanac",
    "overview": "A planner's reference for how transit ran, with warm paper, charcoal ink, fine rules, and condensed uppercase headings. Each report leads with a finding in plain language, then a ruled strip of figures, then the map or chart that explains it, then a table with the evidence. Density is high and the surface stays flat, so the data is the loudest thing on the page.\n\nColor carries meaning. Copper is the one interface accent, the speed classes run warm to cool, and midday blue stands against rush orange. Dark is a chosen theme for working late or presenting, not an inversion: the speed classes are re-tuned so that the slowest streets are the brightest warm marks on dark paper. There is no decorative imagery.",
    "keyCharacteristics": [
      "Warm paper and charcoal ink in two tuned themes, following the system setting unless the visitor chooses.",
      "Big Shoulders Display for headings; the system stack for everything read or compared.",
      "Ruled figure strips and ruled lists instead of cards.",
      "One absolute speed scale across every map and heatmap.",
      "Every figure links to the definition behind it."
    ],
    "rules": [
      {
        "name": "The One Accent Rule",
        "body": "Copper means \"act here\" or \"you are here\". It never encodes data; data color comes from the series and speed tokens.",
        "section": "colors"
      },
      {
        "name": "The Same Scale Rule",
        "body": "Speed classes are absolute, so a color means the same speed on every map, heatmap, and agency. Never rescale them to the data on screen.",
        "section": "colors"
      },
      {
        "name": "The Heading Face Rule",
        "body": "Display type is for headings and the brand mark (21px). The map's hour readout (27px) is the one exception: it reads as the title of the map. Figures, tables, controls, and `h3` stay in the system face.",
        "section": "typography"
      },
      {
        "name": "The Ruled Surface Rule",
        "body": "Group with a rule, not a box. If something needs a shadow, it should be floating over the page.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do lead a report with its finding, then figures, then the evidence.",
      "Do add new colors as CSS variables with values for both themes, and read them with `var()` or from computed style in canvas and map code.",
      "Do use the shared speed scale for any speed shown as color, with `SpeedLegend` beside it.",
      "Do wrap every computed figure's name in `Term`.",
      "Do keep tables in `DataTable`, with `limit={25}` for anything long.",
      "Do say what isn't known: gray for unmeasured streets, a dash for missing values, a plain sentence when a map can't draw.",
      "Do check every change at 390px and in both themes."
    ],
    "donts": [
      "Don't put figures in cards or tiles; use the ruled strip.",
      "Don't set figures, table values, or controls in the display face.",
      "Don't use copper to encode data, or reassign a series color's meaning in one chart.",
      "Don't scale whole charts or tables down to fit a narrow screen; contain the scroll and keep the axis text at 11px.",
      "Don't add shadows to anything resting on the page.",
      "Don't add decorative imagery, or apply Trusted Health or Hex branding to this personal project."
    ]
  }
