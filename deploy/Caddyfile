{
	admin off
	auto_https off
	persist_config off
}

:{$PORT:8080} {
	root * {$SITE_ROOT:/srv}

	@page path / /index.html
	@versioned path /assets/* /engine/extensions/v2.0.0/wasm_eh/*
	@wasm path *.wasm
	@sidecar path *.gz

	route {
		header {
			import security.caddy
			Strict-Transport-Security "max-age=31536000; includeSubDomains"
		}
		header -Server
		header Cache-Control "no-store, no-transform"
		respond @sidecar 404
		header @page {
			Cache-Control "public, max-age=0, s-maxage=60, must-revalidate, no-transform"
			match status 200 304
		}
		header @versioned {
			Cache-Control "public, max-age=31536000, immutable, no-transform"
			match status 200 206 304
		}
		header @wasm {
			Content-Type application/wasm
			match status 200 206 304
		}

		import archives/{$ALMANAC_ARCHIVES:disabled}/*.caddy

		file_server {
			precompressed gzip
		}
	}

	handle_errors 401 {
		# Keep the browser's authentication prompt on the sign-in page.
		@archiveObject expression `{orig_path}.matches('^/archives/[a-z0-9-]+/compat/v1/')`
		header @archiveObject -WWW-Authenticate
		respond @archiveObject 403
		respond 401
	}
}
